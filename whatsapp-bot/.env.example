# Configuration du Bot WhatsApp (Baileys) pour Carnet d'Entretien

# 1. Numéro WhatsApp auquel envoyer les alertes (format international sans le +, ex: 213555123456 pour Algérie, 33612345678 pour France)
TARGET_WHATSAPP_PHONE=213555123456

# 2. Identifiant de la Salle Firestore (si vous utilisez le partage multi-utilisateurs)
# Vous pouvez trouver votre Room ID dans l'URL d'invitation ou dans Firestore console (collection 'rooms')
FIREBASE_ROOM_ID=

# 3. ID du Projet Firebase (déjà pré-rempli avec votre projet)
FIREBASE_PROJECT_ID=entretien-auto-tracker

# 4. Clé d'API Web Firebase (si accès direct REST aux données)
FIREBASE_API_KEY=AIzaSyA7qjZi_aWunCo15Y96BbvsZfX7n7O8LO8

# 5. Chemin vers le fichier de clé de compte de service Firebase (optionnel si vous l'avez téléchargé depuis la console Firebase)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# 6. Fréquence d'exécution de la vérification (en heures, défaut : 12h)
CHECK_INTERVAL_HOURS=12
